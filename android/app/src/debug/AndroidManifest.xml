<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only voice diagnostics. It touches no camera, OCR or guidance code.

             It is **no longer a launcher entry**: the Live assistant is now part of the real
             assistance screen, and leaving a second icon would offer the user a parallel way
             into a voice session that knows nothing about the kiosk. What remains here is a
             bench for measuring the Live API itself — Georgian recognition runs, model
             identifiers, session limits — which is still needed because R-19 is unfinished.

             Reached deliberately, not by accident:
             adb shell am start -n com.maranella.kioskvision/.voice.VoiceSpikeActivity -->
        <activity
            android:name=".voice.VoiceSpikeActivity"
            android:exported="true"
            android:label="Voice diagnostics (debug)" />
    </application>

</manifest>
