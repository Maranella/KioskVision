<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The whole app is built around the rear camera, so stores should only offer it
         to devices that have one. Runtime code still handles a missing camera. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Voice commands work without a microphone being required to install. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A short buzz tells a blind user when the microphone is actually open. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Requested only when the user first presses "Voice command". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network access.

         These were previously removed with tools:node="remove", so that the app was physically
         incapable of sending anything off the device. That guarantee ends here: the Gemini Live
         voice session streams microphone audio to Google. It is a real change in what this app
         can do with user data, not a build detail.

         What still never leaves the device: camera frames, OCR text, fingertip geometry and all
         guidance. Those stay local by design, and the Live API's 1 FPS video path is useless for
         fingertip tracking anyway. Only voice audio is streamed, only during an active session
         the user started, and only after consent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ package visibility: needed to find the speech recognizer and TTS engines. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".KioskVisionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KioskVision">
        <!-- The exported MAIN/LAUNCHER activity, labelled with the app name, is all the system
             assistant needs for "Hey Google, open KioskVision". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KioskVision"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>